        call SetUnitAnimation(boss, "attack")
        call dummyspawn(boss , 1 , 'A0XQ' , 0 , 0)
        call IssueTargetOrder(bj_lastCreatedUnit, "drunkenhaze", u)
    endif
    
    set u=null
    set boss=null
