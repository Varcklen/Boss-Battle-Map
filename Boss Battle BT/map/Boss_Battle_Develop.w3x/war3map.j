    set gg_trg_Voidlord5=CreateTrigger()
    call DisableTrigger(gg_trg_Voidlord5)
    call TriggerRegisterVariableEvent(gg_trg_Voidlord5, "udg_AfterDamageEvent", EQUAL, 1.00)
