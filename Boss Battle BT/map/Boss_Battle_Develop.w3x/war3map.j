    call TriggerRegisterAnyUnitEventBJ(gg_trg_SniperR, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_SniperR, Condition(function Trig_SniperR_Conditions))
