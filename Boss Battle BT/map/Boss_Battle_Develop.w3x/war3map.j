	call BlzFrameSetPoint(unittool, FRAMEPOINT_TOP, unitfon, FRAMEPOINT_TOP, 0., - 0.06)
	call BlzFrameSetText(unittool, "")

	call BlzFrameSetVisible(unitfon, false)
endfunction

