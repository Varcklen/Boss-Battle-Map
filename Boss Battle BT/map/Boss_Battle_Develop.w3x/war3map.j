                    call SaveUnitHandle(udg_hash, id, StringHash("admr"), udg_DamageEventSource)
                    call TimerStart(LoadTimerHandle(udg_hash, GetHandleId(udg_DamageEventSource), StringHash("admr")), 0.01, false, function AdmWCast)
