	//call SaveUnitHandle( udg_hash, id, StringHash( "snp" ), udg_DamageEventTarget ) 
	call TimerStart(LoadTimerHandle(udg_hash, GetHandleId(udg_DamageEventTarget), StringHash("snp")), 4, false, function SniperPCast)
endfunction

