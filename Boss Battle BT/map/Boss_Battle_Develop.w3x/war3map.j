            call spectimeunit(udg_hero[i] , "Abilities\\Spells\\Undead\\FrostNova\\FrostNovaTarget.mdl" , "origin" , 1)
            call bufst(udg_DamageEventTarget , udg_hero[i] , 'A0ZC' , 'B099' , "bswr4" , 15)
        endif
        set i=i + 1
    endloop
endfunction

