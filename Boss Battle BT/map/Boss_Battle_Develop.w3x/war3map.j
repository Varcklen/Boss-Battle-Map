    return inv(GetSpellAbilityUnit() , 'I0F3') > 0 and not ( LoadBoolean(udg_hash, GetHandleId(GetSpellAbilityUnit()), StringHash("orbew")) ) and combat(GetSpellAbilityUnit() , false , 0)
endfunction

