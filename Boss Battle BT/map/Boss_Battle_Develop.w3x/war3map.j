    set gg_trg_SirenaR=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_SirenaR, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_SirenaR, Condition(function Trig_SirenaR_Conditions))
