//===========================================================================
// Trigger: CreatePlayers
//===========================================================================
function Trig_CreatePlayers_Func017Func002C takes nothing returns boolean
    if ( not ( udg_hero[GetForLoopIndexA()] != null ) ) then
        return false
    endif
    return true
endfunction

function Trig_CreatePlayers_Actions takes nothing returns nothing
    call CreateNUnitsAtLoc(1, 'N00N', Player(1), OffsetLocation(GetRectCenter(gg_rct_HeroTp), - 120.00, 120.00), bj_UNIT_FACING)
    set udg_hero[2]=GetLastCreatedUnit()
    call CreateNUnitsAtLoc(1, 'N04H', Player(2), OffsetLocation(GetRectCenter(gg_rct_HeroTp), 0.00, 120.00), bj_UNIT_FACING)
    set udg_hero[3]=GetLastCreatedUnit()
    call CreateNUnitsAtLoc(1, 'N01M', Player(3), OffsetLocation(GetRectCenter(gg_rct_HeroTp), 120.00, 120.00), bj_UNIT_FACING)
    set udg_hero[4]=GetLastCreatedUnit()
    set udg_Ability_Uniq[2]='A0AG'
    set udg_Ability_Uniq[3]='A0GC'
    set udg_Ability_Uniq[4]='A0AG'
    call SetUnitUserData(udg_hero[2], 2)
    call SetUnitUserData(udg_hero[3], 3)
    call SetUnitUserData(udg_hero[4], 4)
    call SaveReal(udg_hash, GetHandleId(udg_hero[2]), StringHash("spd"), 1)
    call SaveReal(udg_hash, GetHandleId(udg_hero[3]), StringHash("spd"), 1)
    call SaveReal(udg_hash, GetHandleId(udg_hero[4]), StringHash("spd"), 1)
    set bj_forLoopAIndex=1
    set bj_forLoopAIndexEnd=4
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        set udg_combatlogic[GetForLoopIndexA()]=true
        if ( Trig_CreatePlayers_Func017Func002C() ) then
            set udg_combatlogic[GetForLoopIndexA()]=true
            call GroupAddUnitSimple(udg_hero[GetForLoopIndexA()], udg_otryad)
            call GroupAddUnitSimple(udg_hero[GetForLoopIndexA()], udg_heroinfo)
            call CreateItemLoc('I0DG', GetRectCenter(gg_rct_HeroTp))
            call UnitAddItemSwapped(GetLastCreatedItem(), udg_hero[GetForLoopIndexA()])
        else
            call DoNothing()
        endif
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
endfunction

