function AllDeadIdol takes nothing returns boolean
    local integer cyclA= 1
    local integer i= 0
    local boolean l= false
    
    loop
        exitwhen cyclA > 4
        if GetUnitState(udg_hero[cyclA], UNIT_STATE_LIFE) <= 0.405 then
            set i=i + 1
        endif
        set cyclA=cyclA + 1
    endloop
    if i >= 3 then
        set l=true
    endif
    return l
endfunction

