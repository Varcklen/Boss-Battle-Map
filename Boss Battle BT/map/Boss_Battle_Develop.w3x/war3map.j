function InitTrig_Succubus2 takes nothing returns nothing
    set gg_trg_Succubus2=CreateTrigger()
    call DisableTrigger(gg_trg_Succubus2)
    call TriggerRegisterVariableEvent(gg_trg_Succubus2, "udg_AfterDamageEvent", EQUAL, 1.00)
    call TriggerAddCondition(gg_trg_Succubus2, Condition(function Trig_Succubus2_Conditions))
