//library CombatLib:

    function combat takes unit u,boolean b,integer sp returns boolean
        local boolean l= true
        if not ( udg_combatlogic[GetPlayerId(GetOwningPlayer(u)) + 1] ) then
            if b and IsUnitInGroup(u, udg_heroinfo) and GetSpellAbilityId() == sp then
                call textst("|c00909090 Doesn't work out of combat" , u , 64 , 90 , 10 , 1)
            endif
            set l=false
        endif
        set u=null
        return l
    endfunction


//library CombatLib ends
//library DeathLib:

    //Is unit can be target of battle ressurect
    function DeathIf takes unit u returns boolean
        local boolean l= false
        if GetUnitAbilityLevel(u, 'A05X') == 0 and not ( IsUnitInGroup(u, udg_Return) ) and udg_Heroes_Ressurect_Battle <= 0 and IsUnitInGroup(u, udg_otryad) then
            set l=true
        endif
        set u=null
        return l
    endfunction

    function IsUnitAlive takes unit myUnit returns boolean
        local boolean isWork= false
        if GetUnitState(myUnit, UNIT_STATE_LIFE) > 0.405 then
            set isWork=true
        endif
        set myUnit=null
        return isWork
    endfunction

    function IsUnitDead takes unit myUnit returns boolean
        local boolean isWork= false
        if GetUnitState(myUnit, UNIT_STATE_LIFE) <= 0.405 then
            set isWork=true
        endif
        set myUnit=null
        return isWork
    endfunction


