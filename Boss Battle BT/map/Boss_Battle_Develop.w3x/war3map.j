        // Hibryds
        set s__HeroesTableDatabase_HEROES_IN_CLASS[3]= 9
        set s__HeroFrame[(3)*(9)+0]= s__HeroFramehandle_create('O00E' , "Varcklen" , 0 , "ReplaceableTextures\\CommandButtons\\BTNEarthBrewmaster.blp")
        set s__HeroFrame[(3)*(9)+1]= s__HeroFramehandle_create('O00I' , "Varcklen" , 1 , "ReplaceableTextures\\CommandButtons\\BTNHeadhunter.blp")
        set s__HeroFrame[(3)*(9)+2]= s__HeroFramehandle_create('O00Z' , "LightBeam" , 1 , "ReplaceableTextures\\CommandButtons\\BTNDryad.blp")
        set s__HeroFrame[(3)*(9)+3]= s__HeroFramehandle_create('O00N' , "ZiHeLL" , 1 , "war3mapImported\\BTNSummonWaterElemental.blp")
        set s__HeroFrame[(3)*(9)+4]= s__HeroFramehandle_create('O017' , "Eric" , 1 , "ReplaceableTextures\\CommandButtons\\BTNWitchDoctor.blp")
        set s__HeroFrame[(3)*(9)+5]= s__HeroFramehandle_create('O01N' , "faceroll and ZiHeLL" , 1 , "ReplaceableTextures\\CommandButtons\\BTNHeroBloodElfPrince.blp")
        set s__HeroFrame[(3)*(9)+6]= s__HeroFramehandle_create('U00T' , "Varcklen" , 2 , "ReplaceableTextures\\CommandButtons\\BTNHeroLich.blp")
        set s__HeroFrame[(3)*(9)+7]= s__HeroFramehandle_create('O00T' , "Varcklen" , 2 , "ReplaceableTextures\\CommandButtons\\BTNUnbroken.blp")
        set s__HeroFrame[(3)*(9)+8]= s__HeroFramehandle_create('O01O' , "ZiHeLL" , 2 , "war3mapImported\\BTNEasterWabbit.blp")
        
        set s__HeroFramehandle_story[s__HeroFrame[(3)*(9)+0]]="Cho is a peppy beer monk who wanders the world in search of new types of drinks. His life is full of fun and travel. Due to his martial arts skills, he was nicknamed the \"Beer Fighter\"."
        set s__HeroFramehandle_story[s__HeroFrame[(3)*(9)+1]]="Brave troll breeder. Summons a pet to help him fight by his side."
        set s__HeroFramehandle_story[s__HeroFrame[(3)*(9)+3]]="Created by collective effort of greatest Mages and Alchemists, Lye is abnormally destructive mindless doll. He is almost a disaster in his magical body, poisoning lives and disrupting not only physical, but even mental health of those who appear nearby."
        set s__HeroFramehandle_story[s__HeroFrame[(3)*(9)+4]]="Once, Erks tribes homelands were bound in great arcane mysteries, teeming with magic which sought manipulatable hosts. Slowly it seeped into his tribe and loved ones, irreparably blackening their thoughts and dreams. Before Erk was fully enveloped, he was able to break out and ran wherever he could. Although free, the magic still lingers within - swarming the mind with entropic visions of hate. Erk believes however, he could potentially harness this magic to help others where he once could not."
        set s__HeroFramehandle_story[s__HeroFrame[(3)*(9)+5]]="A child of noble birth, educated at esteemed schools. He began poetry at 19, and after gaining worldwide fame as one of the best minstrels in the Northern Kingdoms he is approached by a mysterious man. After some time together, the man bestows a power upon Jaskier which allows him to sew magic into his poems."
        set s__HeroFramehandle_story[s__HeroFrame[(3)*(9)+6]]="A resurrected who is able to turn your opponent into your ally."
        set s__HeroFramehandle_story[s__HeroFrame[(3)*(9)+7]]="A faceless lord who does whatever he pleases."
        set s__HeroFramehandle_story[s__HeroFrame[(3)*(9)+8]]="Bonnie and Bor Rise and real bros. They rarely brawl, but more rarely win. Never are bored and they rest undisturbed. Don't tolerate robbery and less so for snobbery. They break all the eggs and wear some rags. Bravo, i guess."
        
        call s__HeroFramehandle_AddRoles(s__HeroFrame[(3)*(9)+0],ROLE_PHYSICAL_DAMAGE , ROLE_HEAL , 0 , 0)
        call s__HeroFramehandle_AddRoles(s__HeroFrame[(3)*(9)+1],ROLE_PHYSICAL_DAMAGE , ROLE_SUMMONER , 0 , 0)
