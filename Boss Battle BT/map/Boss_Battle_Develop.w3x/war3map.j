        call s__HeroFramehandle_AddRoles(s__HeroFrame[(2)*(9)+4],ROLE_PHYSICAL_DAMAGE , 0 , 0 , 0)
        call s__HeroFramehandle_AddRoles(s__HeroFrame[(2)*(9)+5],ROLE_PHYSICAL_DAMAGE , ROLE_CONTROL , 0 , 0)
