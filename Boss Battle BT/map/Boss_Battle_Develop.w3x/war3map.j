    set udg_SaveLoadMaxCharacters=36
    set udg_SaveLoadEncryptionSet[1]="JCYVQSB71EXK65WZ0LTA2POM8UIRHD43N9FG"
    set udg_SaveLoadEncryptionSet[2]="A09UYH1R3CMZBK4DQ8OTS5LVIXPF7NGJ2E6W"
