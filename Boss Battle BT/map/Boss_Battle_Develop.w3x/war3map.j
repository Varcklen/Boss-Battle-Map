        set s__HeroFrame[(5)*(9)+3]= s__HeroFramehandle_create('N057' , "stonebludgeon" , 0 , "war3mapImported\\BTNskinvaleera.blp")
        set s__HeroFrame[(5)*(9)+4]= s__HeroFramehandle_create('N02E' , "Varcklen" , 0 , "ReplaceableTextures\\CommandButtons\\BTNRifleman.blp")
        set s__HeroFrame[(5)*(9)+5]= s__HeroFramehandle_create('N04M' , "vatk0end" , 1 , "ReplaceableTextures\\CommandButtons\\BTNHeroWarden.blp")
        set s__HeroFrame[(5)*(9)+6]= s__HeroFramehandle_create('N02G' , "ZiHeLL" , 1 , "ReplaceableTextures\\CommandButtons\\BTNPriestessOfTheMoon.blp")
        set s__HeroFrame[(5)*(9)+7]= s__HeroFramehandle_create('N032' , "Varcklen" , 2 , "ReplaceableTextures\\CommandButtons\\BTNBansheeRanger.blp")
        set s__HeroFrame[(5)*(9)+8]= s__HeroFramehandle_create('N04K' , "Leviolon" , 2 , "ReplaceableTextures\\CommandButtons\\BTNArchimonde.blp")

        set s__HeroFramehandle_story[s__HeroFrame[(5)*(9)+0]]="A royal mermaid who came to fight."
        set s__HeroFramehandle_story[s__HeroFrame[(5)*(9)+1]]="An old blademaster who is trying to find a worthy death in combat."
        set s__HeroFramehandle_story[s__HeroFrame[(5)*(9)+4]]="Crazymeister is an elderly old man from a quiet village. He went on a journey to improve his rifle, which he affectionately calls \"Mary Sue\". Rumor has it that the old man went crazy, but no one has ever said the exact statements."
        set s__HeroFramehandle_story[s__HeroFrame[(5)*(9)+6]]="Meow meow mew meow meow. Meow, meow meew meow! Meow. Meow mew meoowwww."
        set s__HeroFramehandle_story[s__HeroFrame[(5)*(9)+7]]="A mysterious elf who came from the world of shadows."

        call s__HeroFramehandle_AddRoles(s__HeroFrame[(5)*(9)+0],ROLE_PHYSICAL_DAMAGE , ROLE_MAGIC_DAMAGE , 0 , 0)
