function InitTrig_Manashtorm takes nothing returns nothing
    set gg_trg_Manashtorm=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_Manashtorm, EVENT_PLAYER_UNIT_SPELL_EFFECT)
