        exitwhen cyclA > cyclAEnd
        call healst(caster , target , heal)
        call DestroyEffect(AddSpecialEffectTarget("war3mapImported\\MiniRessurection.mdx", target, "origin"))
        set cyclA=cyclA + 1
    endloop
    
    set caster=null
    set target=null
