    set gg_trg_Pyromant1=CreateTrigger()
    call DisableTrigger(gg_trg_Pyromant1)
    call TriggerRegisterVariableEvent(gg_trg_Pyromant1, "udg_AfterDamageEvent", EQUAL, 1.00)
