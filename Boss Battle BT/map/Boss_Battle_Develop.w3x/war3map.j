    call dummyspawn(caster , 1 , 0 , 0 , 0)
    call UnitDamageTarget(bj_lastCreatedUnit, target, 20, true, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC, WEAPON_TYPE_WHOKNOWS)
    call FlushChildHashtable(udg_hash, id)

    set target=null
    set caster=null
endfunction

