	call TimerStart(LoadTimerHandle(udg_hash, GetHandleId(udg_DamageEventTarget), StringHash("bsmtr")), bosscast(7), true, function MageTruch1Cast)
    
    set id=GetHandleId(udg_DamageEventTarget)
