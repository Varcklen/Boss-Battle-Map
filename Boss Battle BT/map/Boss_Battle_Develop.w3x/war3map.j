        call s__HeroFramehandle_AddRoles(s__HeroFrame[(1)*(9)+4],ROLE_DEFEND , ROLE_MAGIC_DAMAGE , 0 , 0)
        call s__HeroFramehandle_AddRoles(s__HeroFrame[(1)*(9)+5],ROLE_DEFEND , ROLE_SUMMONER , 0 , 0)
        call s__HeroFramehandle_AddRoles(s__HeroFrame[(1)*(9)+6],ROLE_DEFEND , ROLE_CONTROL , 0 , 0)
