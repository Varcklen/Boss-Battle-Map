            call SetUnitState(bj_lastCreatedUnit, UNIT_STATE_LIFE, GetUnitState(udg_DamageEventTarget, UNIT_STATE_LIFE))
            call IssueTargetOrder(bj_lastCreatedUnit, "attack", udg_hero[cyclA])
