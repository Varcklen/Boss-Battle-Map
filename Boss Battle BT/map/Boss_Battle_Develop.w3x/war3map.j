        call s__HeroFramehandle_AddRoles(s__HeroFrame[(4)*(9)+5],ROLE_SUPPORT , 0 , 0 , 0)
        call s__HeroFramehandle_AddRoles(s__HeroFrame[(4)*(9)+6],ROLE_SUPPORT , ROLE_HEAL , ROLE_PHYSICAL_DAMAGE , 0)
        call s__HeroFramehandle_AddRoles(s__HeroFrame[(4)*(9)+7],ROLE_PHYSICAL_DAMAGE , ROLE_DEFEND , 0 , 0)
