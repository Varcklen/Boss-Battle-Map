function Trig_Sneaky_Actions takes nothing returns nothing
    local unit caster
    local unit target
    local integer id
    
    if CastLogic() then
        set caster=udg_Caster
        set target=udg_Target
    elseif RandomLogic() then
        set caster=udg_Caster
        set target=randomtarget(caster , 900 , "ally" , "" , "" , "" , "")
