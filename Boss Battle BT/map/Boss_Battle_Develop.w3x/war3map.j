    set udg_DB_ModesFrame_Difficulty[4]='A045'
    set udg_DB_ModesFrame_Difficulty[5]='A048'
    set udg_DB_ModesFrame_Difficulty[6]='A04H'
    set udg_DB_ModesFrame_Difficulty[7]='AZD1'
