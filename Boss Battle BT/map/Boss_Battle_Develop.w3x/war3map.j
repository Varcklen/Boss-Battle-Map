    set udg_logic[GetPlayerId(GetOwningPlayer(GetSpellAbilityUnit())) + 1 + 43]=true
    call stazisst(GetSpellAbilityUnit() , GetItemOfTypeFromUnitBJ(GetSpellAbilityUnit(), 'I08A'))
endfunction

