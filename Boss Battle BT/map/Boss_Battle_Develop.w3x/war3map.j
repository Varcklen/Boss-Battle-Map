        set id=GetHandleId(LoadTimerHandle(udg_hash, id, StringHash("bshr5")))
        call SaveUnitHandle(udg_hash, id, StringHash("bshr5"), u)
        call SaveUnitHandle(udg_hash, id, StringHash("bshr5b"), udg_DamageEventTarget)
