    //Obsolete. Do not use
    function CreateTrigger_DeleteBuff takes code func returns nothing
        local trigger trig= CreateTrigger()

        call TriggerRegisterVariableEvent(trig, "Event_DeleteBuff_Real", EQUAL, 1.00)
        call TriggerAddAction(trig, func)
        
        set trig=null
    endfunction

