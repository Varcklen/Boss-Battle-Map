function Trig_FastStart_Data_Actions takes nothing returns nothing
    set udg_DB_FS_Size=17
    // Боец
    set udg_DB_FS_Name[1]="Fighter"
    set udg_DB_FS_Start[1]=1
    set udg_DB_FS_End[1]=28
