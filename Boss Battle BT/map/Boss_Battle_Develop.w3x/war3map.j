function InitTrig_Iromforge takes nothing returns nothing
    set gg_trg_Iromforge=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_Iromforge, EVENT_PLAYER_UNIT_USE_ITEM)
