    call CreateQuestBJ(bj_QUESTTYPE_REQ_DISCOVERED, "TRIGSTR_009", "TRIGSTR_010", "ReplaceableTextures\\CommandButtons\\BTNSelectHeroOn.blp")
    call CreateQuestBJ(bj_QUESTTYPE_REQ_DISCOVERED, "TRIGSTR_011", "TRIGSTR_006", "ReplaceableTextures\\CommandButtons\\BTNStrongDrink.blp")
    call CreateQuestBJ(bj_QUESTTYPE_REQ_DISCOVERED, "TRIGSTR_012", "TRIGSTR_002", "ReplaceableTextures\\CommandButtons\\BTNMurgalSlave.blp")
    // Old Change Notes
    call CreateQuestBJ(bj_QUESTTYPE_REQ_DISCOVERED, "TRIGSTR_11364", "TRIGSTR_11402", "ReplaceableTextures\\CommandButtons\\BTNScroll.blp")
    call CreateQuestBJ(bj_QUESTTYPE_REQ_DISCOVERED, "TRIGSTR_11416", "TRIGSTR_11417", "ReplaceableTextures\\CommandButtons\\BTNScroll.blp")
    // ----
    call CreateQuestBJ(bj_QUESTTYPE_OPT_DISCOVERED, "TRIGSTR_013", "TRIGSTR_003", "ReplaceableTextures\\CommandButtons\\BTNHeartOfAszune.blp")
    call CreateQuestBJ(bj_QUESTTYPE_OPT_DISCOVERED, "TRIGSTR_014", "TRIGSTR_004", "ReplaceableTextures\\CommandButtons\\BTNCrystalBall.blp")
    call CreateQuestBJ(bj_QUESTTYPE_OPT_DISCOVERED, "TRIGSTR_015", "TRIGSTR_005", "war3mapImported\\PASBTNAchievement_BG_returnXflags_def_WSG.blp")
endfunction

