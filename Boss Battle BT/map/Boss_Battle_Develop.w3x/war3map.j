    call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Human\\Invisibility\\InvisibilityTarget.mdl", GetUnitX(target), GetUnitY(target)))
    
    call dummyspawn(caster , 1 , 'A0CQ' , 0 , 0)
