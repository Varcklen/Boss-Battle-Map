    		set y=GetRectCenterY(udg_Boss_Rect) + 2000 * Sin(( 45 + ( 90 * cyclA ) ) * bj_DEGTORAD)
    		call CreateUnit(GetOwningPlayer(udg_DamageEventTarget), 'n02V', x, y, 270)
