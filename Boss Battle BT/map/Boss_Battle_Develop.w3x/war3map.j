//===========================================================================
// Trigger: Undercity
//===========================================================================
function Trig_Undercity_Conditions takes nothing returns boolean
    return GetItemTypeId(GetManipulatedItem()) == 'I0CD'
endfunction

function Trig_Undercity_Actions takes nothing returns nothing
 local integer cyclA= 2
 local integer array it

	set it[0]=0
	set it[1]=0
	loop
		exitwhen cyclA > 4
		if cyclA == 4 then
			set it[cyclA]=s__DB_SetItems[(3)*(100)+GetRandomInt(1, udg_DB_SetItems_Num[3])]
		elseif cyclA == 2 then
			set it[cyclA]=s__DB_SetItems[(8)*(100)+GetRandomInt(1, udg_DB_SetItems_Num[8])]
		elseif cyclA == 3 then
			set it[cyclA]=s__DB_SetItems[(4)*(100)+GetRandomInt(1, udg_DB_SetItems_Num[4])]
		endif
		if ( it[cyclA] == it[cyclA - 1] or it[cyclA] == it[cyclA - 2] ) then
			set cyclA=cyclA - 1
		endif
		set cyclA=cyclA + 1
	endloop
	call forge(GetManipulatingUnit() , GetManipulatedItem() , it[4] , it[2] , it[3] , true)
endfunction

