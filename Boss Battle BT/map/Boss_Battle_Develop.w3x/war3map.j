        set s__HeroFramehandle_story[s__HeroFrame[(6)*(9)+0]]="An energy ball consisting of lightning and energy."
        set s__HeroFramehandle_story[s__HeroFrame[(6)*(9)+2]]="An ancient lord who wishes to kindle the \"First Flame\"."
        set s__HeroFramehandle_story[s__HeroFrame[(6)*(9)+4]]="Van always dreamed about starting a cult of his own. His twisted ideals led to him becoming a warlock, but he knew that was not the way of gaining support in the masses. Using the newly acquired powers in the strangest manners imaginable, he soon became a great healer as well, but could never overcome his sadistic nature."
        set s__HeroFramehandle_story[s__HeroFrame[(6)*(9)+5]]="Shaderosia was formed out of the Abyss Matter itself. It has no goal other than slowly devastating, decimating and, eventually, devouring everything on its way. Erasing bosses is not her true intention, but Shaderosia wouldn’t mind doing it regardless."
        set s__HeroFramehandle_story[s__HeroFrame[(6)*(9)+6]]="A moonkin with arcane spells."
        set s__HeroFramehandle_story[s__HeroFrame[(6)*(9)+7]]="No one knows for sure where, how and why time exists, but many believe that Tempus is involved in the events of the creation of the World. Little is known about Tempus, but what is known about him only raises new questions. It is known that this mysterious traveler arrived at the arena to get rid of a temporary anomaly that occurred in these parts."
        
        call s__HeroFramehandle_AddRoles(s__HeroFrame[(6)*(9)+0],ROLE_MAGIC_DAMAGE , 0 , 0 , 0)
        call s__HeroFramehandle_AddRoles(s__HeroFrame[(6)*(9)+1],ROLE_MAGIC_DAMAGE , 0 , 0 , 0)
        call s__HeroFramehandle_AddRoles(s__HeroFrame[(6)*(9)+2],ROLE_MAGIC_DAMAGE , 0 , 0 , 0)
        call s__HeroFramehandle_AddRoles(s__HeroFrame[(6)*(9)+3],ROLE_MAGIC_DAMAGE , ROLE_PHYSICAL_DAMAGE , ROLE_SUMMONER , ROLE_DEFEND)
        call s__HeroFramehandle_AddRoles(s__HeroFrame[(6)*(9)+4],ROLE_MAGIC_DAMAGE , ROLE_HEAL , 0 , 0)
        call s__HeroFramehandle_AddRoles(s__HeroFrame[(6)*(9)+5],ROLE_MAGIC_DAMAGE , 0 , 0 , 0)
        call s__HeroFramehandle_AddRoles(s__HeroFrame[(6)*(9)+6],ROLE_MAGIC_DAMAGE , 0 , 0 , 0)
        call s__HeroFramehandle_AddRoles(s__HeroFrame[(6)*(9)+7],ROLE_MAGIC_DAMAGE , ROLE_PHYSICAL_DAMAGE , 0 , 0)
        
        // Healers
        set s__HeroesTableDatabase_HEROES_IN_CLASS[7]= 9
        set s__HeroFrame[(7)*(9)+0]= s__HeroFramehandle_create('N002' , "Varcklen" , 0 , "ReplaceableTextures\\CommandButtons\\BTNDruidOfTheTalon.blp")
        set s__HeroFrame[(7)*(9)+1]= s__HeroFramehandle_create('N02S' , "Varcklen" , 0 , "ReplaceableTextures\\CommandButtons\\BTNMurgulShadowCaster.blp")
        set s__HeroFrame[(7)*(9)+2]= s__HeroFramehandle_create('N01M' , "Cotya_Ra" , 1 , "ReplaceableTextures\\CommandButtons\\BTNHeroPaladin.blp")
        set s__HeroFrame[(7)*(9)+3]= s__HeroFramehandle_create('N02Q' , "Varcklen" , 1 , "ReplaceableTextures\\CommandButtons\\BTNDranaiMage.blp")
        set s__HeroFrame[(7)*(9)+4]= s__HeroFramehandle_create('N04A' , "Ratman" , 1 , "ReplaceableTextures\\CommandButtons\\BTNYouDirtyRat!.blp")
        set s__HeroFrame[(7)*(9)+5]= s__HeroFramehandle_create('N017' , "faceroll" , 1 , "ReplaceableTextures\\CommandButtons\\BTNCorruptedEnt.blp")
        set s__HeroFrame[(7)*(9)+6]= s__HeroFramehandle_create('N038' , "Varcklen" , 2 , "ReplaceableTextures\\CommandButtons\\BTNHarpyWitch.blp")
        set s__HeroFrame[(7)*(9)+7]= s__HeroFramehandle_create('N01R' , "regint" , 2 , "ReplaceableTextures\\CommandButtons\\BTNKelThuzad.blp")
        set s__HeroFrame[(7)*(9)+8]= s__HeroFramehandle_create('N04W' , "Yoti Coyote" , 2 , "ReplaceableTextures\\CommandButtons\\BTNDestroyer.blp")

        set s__HeroFramehandle_story[s__HeroFrame[(7)*(9)+0]]="Since childhood, Bob has loved to enjoy his parents' garden in Nordel. When Bob was strong enough, he left his hometown to become a druid. However, by the end of his training, his hometown was struck by an unknown corruption. Upon learning of this, this young druid decided to figure out how to get rid of this disease. He learned that if he went to the arena, he could find answers."
        set s__HeroFramehandle_story[s__HeroFrame[(7)*(9)+1]]="Experienced medicine fishman of the drained murloc tribe."
        set s__HeroFramehandle_story[s__HeroFrame[(7)*(9)+2]]="A vain paladin who was banished from the shrine."
        set s__HeroFramehandle_story[s__HeroFrame[(7)*(9)+3]]="A sage who came from a parallel universe."
        set s__HeroFramehandle_story[s__HeroFrame[(7)*(9)+5]]="A beech sapling that spent several years at the base of a factory that manufactures chemicals, warped over time by corruption and eventually grew sentience. The tree uprooted itself and left to wander the earth aimlessly. Beechbone encountered many situations that changed his perspective on man, and so he avoids them and dislikes them. He prefers to use his healing powers on animals and other flora and fauna."
        set s__HeroFramehandle_story[s__HeroFrame[(7)*(9)+6]]="A legendary harpy that was captured by a hunter and sold into the arena to please the public."

        call s__HeroFramehandle_AddRoles(s__HeroFrame[(7)*(9)+0],ROLE_HEAL , ROLE_SUMMONER , 0 , 0)
        call s__HeroFramehandle_AddRoles(s__HeroFrame[(7)*(9)+1],ROLE_HEAL , 0 , 0 , 0)
        call s__HeroFramehandle_AddRoles(s__HeroFrame[(7)*(9)+2],ROLE_HEAL , ROLE_MAGIC_DAMAGE , 0 , 0)
        call s__HeroFramehandle_AddRoles(s__HeroFrame[(7)*(9)+3],ROLE_HEAL , ROLE_SUPPORT , 0 , 0)
        call s__HeroFramehandle_AddRoles(s__HeroFrame[(7)*(9)+4],ROLE_HEAL , ROLE_MAGIC_DAMAGE , 0 , 0)
        call s__HeroFramehandle_AddRoles(s__HeroFrame[(7)*(9)+5],ROLE_HEAL , ROLE_MAGIC_DAMAGE , 0 , 0)
        call s__HeroFramehandle_AddRoles(s__HeroFrame[(7)*(9)+6],ROLE_HEAL , ROLE_SUPPORT , 0 , 0)
        call s__HeroFramehandle_AddRoles(s__HeroFrame[(7)*(9)+7],ROLE_HEAL , ROLE_SUPPORT , 0 , 0)
        call s__HeroFramehandle_AddRoles(s__HeroFrame[(7)*(9)+8],ROLE_HEAL , ROLE_MAGIC_DAMAGE , 0 , 0)
        
        // Curses
        set s__HeroesTableDatabase_HEROES_IN_CLASS[8]= 8
        set s__HeroFrame[(8)*(9)+0]= s__HeroFramehandle_create('O00K' , "Varcklen" , 0 , "ReplaceableTextures\\CommandButtons\\BTNHeroTinker.blp")
        set s__HeroFrame[(8)*(9)+1]= s__HeroFramehandle_create('O00X' , "Varcklen" , 0 , "ReplaceableTextures\\CommandButtons\\BTNSatyrTrickster.blp")
        set s__HeroFrame[(8)*(9)+2]= s__HeroFramehandle_create('O01Y' , "Rena" , 0 , "ReplaceableTextures\\CommandButtons\\BTNWindSerpent.blp")
        set s__HeroFrame[(8)*(9)+3]= s__HeroFramehandle_create('O018' , "ZiHeLL" , 1 , "ReplaceableTextures\\CommandButtons\\BTNPriest.blp")
        set s__HeroFrame[(8)*(9)+4]= s__HeroFramehandle_create('O01J' , "Lichloved" , 1 , "ReplaceableTextures\\CommandButtons\\BTNRevenant.blp")
        set s__HeroFrame[(8)*(9)+5]= s__HeroFramehandle_create('O014' , "Shkolion and h3ts" , 1 , "war3mapImported\\BTNKingOfGhouls_Icon.blp")
        set s__HeroFrame[(8)*(9)+6]= s__HeroFramehandle_create('O00D' , "Varcklen" , 2 , "BTNSpell_Shadow_SummonVoidWalker.blp")
        set s__HeroFrame[(8)*(9)+7]= s__HeroFramehandle_create('O016' , "Rena" , 2 , "ReplaceableTextures\\CommandButtons\\BTNForgottenOne.blp")
        
        set s__HeroFramehandle_story[s__HeroFrame[(8)*(9)+0]]="A merry goblin from a distant land, traveling for interesting encounters. And mechs."
        set s__HeroFramehandle_story[s__HeroFrame[(8)*(9)+1]]="An ancient monster that devours the dreams and memories of living beings. It used to live in Nordel, but now it feeds on the weaknesses of the gladiators of the arena."
        set s__HeroFramehandle_story[s__HeroFrame[(8)*(9)+2]]="A scientist named Mengeles had been experimenting with extracts, in search of potent reagents had messed up an equation and discovered a nightmarish transformation instead. Paralysis had consumed them and they fell into a coma. Mengeles awoke years later, no longer a reknown scientist, but now known as The Plague. His abandoned laboratory too confining, and some human curiosity made them set out in search of greater experiments."
        set s__HeroFramehandle_story[s__HeroFrame[(8)*(9)+3]]="Referi is a prime ice wizard, unrivalled in his ability. It is a common knowledge that he once froze the entire fourth wall just to melt it with his hot elbows. Truth be told, he is actually a machine, a divine construct of the Gods themselves."
        set s__HeroFramehandle_story[s__HeroFrame[(8)*(9)+6]]="An evil spirit that embodies the thirst for revenge."
        set s__HeroFramehandle_story[s__HeroFrame[(8)*(9)+7]]="An initial encounter with a sluglike tentacle that had sprout from the ground marked the start of an inquiry into the great beyond and inevitably led to the establishment of the council. This same council eventually had an epiphany, \"We stand like this tentacle, planted in the earth, but what if the great beyond is near us, only above our heads?\" Members of the council took to the skies with Azathot in search of astral magics that may lead them to achieving greatness and a better understanding of the crawling chaos that inhabited these lands."
        
        call s__HeroFramehandle_AddRoles(s__HeroFrame[(8)*(9)+0],ROLE_MAGIC_DAMAGE , ROLE_CONTROL , 0 , 0)
        call s__HeroFramehandle_AddRoles(s__HeroFrame[(8)*(9)+1],ROLE_MAGIC_DAMAGE , ROLE_PHYSICAL_DAMAGE , 0 , 0)
        call s__HeroFramehandle_AddRoles(s__HeroFrame[(8)*(9)+2],ROLE_MAGIC_DAMAGE , ROLE_CONTROL , 0 , 0)
        call s__HeroFramehandle_AddRoles(s__HeroFrame[(8)*(9)+3],ROLE_MAGIC_DAMAGE , ROLE_CONTROL , 0 , 0)
        call s__HeroFramehandle_AddRoles(s__HeroFrame[(8)*(9)+4],ROLE_MAGIC_DAMAGE , ROLE_SUPPORT , 0 , 0)
        call s__HeroFramehandle_AddRoles(s__HeroFrame[(8)*(9)+5],ROLE_MAGIC_DAMAGE , ROLE_CONTROL , ROLE_SUMMONER , 0)
        call s__HeroFramehandle_AddRoles(s__HeroFrame[(8)*(9)+8],ROLE_MAGIC_DAMAGE , ROLE_SUPPORT , 0 , 0)
        call s__HeroFramehandle_AddRoles(s__HeroFrame[(8)*(9)+7],ROLE_MAGIC_DAMAGE , ROLE_SUMMONER , 0 , 0)
        
        set Event_DatabaseLoaded=0.00
        set Event_DatabaseLoaded=1.00
        set Event_DatabaseLoaded=0.00
    endfunction

    //===========================================================================
    function HeroesTableDatabase___init takes nothing returns nothing
        local trigger delay= CreateTrigger()
        
        call TriggerRegisterTimerEvent(delay, 1., false)
		call TriggerAddAction(delay, function HeroesTableDatabase___Database)
        
        set delay=null
    endfunction


//library HeroesTableDatabase ends
//library IconFrameLib:


function IconMax takes integer index returns nothing
    local integer k= index
    local boolean l
    local integer fix
    
    set udg_IconMax=index
    
    set l=false
    set fix=0
    set bnspos=0
    loop
        exitwhen l
        if fix > 10 then
            call BJDebugMsg("Function \"IconMax\" is not working correctly. Please report this to the developer.")
            set l=true
        elseif k > 8 then
            set bnspos=bnspos + 0.03
            set k=k - 8
        else
            set l=true
        endif
        set fix=fix + 1
    endloop
endfunction

function IconFrameDel takes string k returns nothing
    local integer cyclA
    local integer max= 0

    set cyclA=1
    loop
        exitwhen cyclA > udg_IconLim
        if udg_IconKey[cyclA] == k then
            set udg_IconKey[cyclA]=""
            call BlzFrameSetVisible(bonusframe[cyclA], false)
            set cyclA=udg_IconLim
        endif
        set cyclA=cyclA + 1
    endloop
    
    set cyclA=1
    loop
        exitwhen cyclA > udg_IconLim
        if udg_IconKey[cyclA] != "" then
            set max=cyclA
        endif
        set cyclA=cyclA + 1
    endloop
    call IconMax(max)
endfunction

function StringSizeIconTool takes string s returns real
	return 0.04 + ( 0.0003 * StringLength(s) )
endfunction

function IconFrame takes string k,string icon,string name,string tool returns nothing
    local integer cyclA
    local integer i= 0
    local boolean l= true
    local boolean n= false
    
    set cyclA=1
    loop
        exitwhen cyclA > udg_IconLim
        if udg_IconKey[cyclA] == k then
            set i=cyclA
            set l=false
            set cyclA=udg_IconLim
        endif
        set cyclA=cyclA + 1
    endloop
    
    if l then
        set cyclA=1
        loop
            exitwhen cyclA > udg_IconLim or n
            if udg_IconKey[cyclA] == "" then
                set n=true
                set i=cyclA
                set cyclA=udg_IconLim
            endif
            set cyclA=cyclA + 1
        endloop
        if n then
            call BlzFrameSetText(bonustxtnm[i], name)
            call BlzFrameSetText(bonustxt[i], tool)
            call BlzFrameSetSize(bnfrtlp[i], 0.35, (0.04 + ( 0.0003 * StringLength((tool)) ))) // INLINED!!
            call BlzFrameSetTexture(bonusframe[i], icon, 0, true)
            call BlzFrameSetVisible(bonusframe[i], true)
            set udg_IconKey[i]=k
            
            if i > udg_IconMax then
                call IconMax(i)
            endif
        endif
    else
        call BlzFrameSetText(bonustxtnm[i], name)
        call BlzFrameSetText(bonustxt[i], tool)
        call BlzFrameSetSize(bnfrtlp[i], 0.35, (0.04 + ( 0.0003 * StringLength((tool)) ))) // INLINED!!
        call BlzFrameSetTexture(bonusframe[i], icon, 0, true)
    endif
endfunction

function IconFrameReplaceDescription takes string keyWord,string newDescription returns nothing
    local integer i= 1
    local boolean end= false
    
    loop
        exitwhen i > udg_IconLim or end
        if keyWord == udg_IconKey[i] then
            call BlzFrameSetText(bonustxt[i], newDescription)
            call BlzFrameSetSize(bnfrtlp[i], 0.35, (0.04 + ( 0.0003 * StringLength((newDescription)) ))) // INLINED!!
            set end=true
        endif
        set i=i + 1
    endloop
endfunction

function GetIconFrameNumberByKey takes string keyWord returns integer
    local integer i= 1
    
    loop
        exitwhen i > udg_IconLim
        if keyWord == udg_IconKey[i] then
            return i
        endif
        set i=i + 1
    endloop
    return - 1
endfunction


//library IconFrameLib ends
//library Inventory:

    function inv takes unit u,integer id returns integer
        local integer i= 0
        local integer cyclA= 0
        local item it

        loop
            exitwhen cyclA > 5
            set it=UnitItemInSlot(u, cyclA)
            if GetItemTypeId(it) == id then
                set i=i + 1
            endif
            set cyclA=cyclA + 1
        endloop
        set it=null
        set u=null
        return i
    endfunction

    function IsHeroHasItem takes unit hero,integer itemId returns boolean
        local boolean hasItem= false
        local integer i= 0
        
        loop
            exitwhen i > 5 or hasItem
            if GetItemTypeId(UnitItemInSlot(hero, i)) == itemId then
                set hasItem=true
            endif
            set i=i + 1
        endloop
        set hero=null
        return hasItem
    endfunction

    function Inventory__SetModificators takes unit owner,item oldItem,item newItem returns nothing
        if SubString(BlzGetItemExtendedTooltip(oldItem), 0, 19) == "|cff00cceeChameleon" then
            call BlzSetItemExtendedTooltip(newItem, "|cff00cceeChameleon|r|n" + BlzGetItemExtendedTooltip(newItem)) // sadtwig
            //call BlzSetItemIconPath( newItem, "|cff00cceeChameleon|r|n" + BlzGetItemExtendedTooltip(newItem) )
        endif
        if SubString(BlzGetItemExtendedTooltip(oldItem), 0, 19) == "|cFFFFFF7DChameleon" then
            call BlzSetItemExtendedTooltip(newItem, "|cFFFFFF7DChameleon|r|n" + BlzGetItemExtendedTooltip(newItem)) // sadtwig
            //call BlzSetItemIconPath( newItem, "|cFFFFFF7DChameleon|r|n" + BlzGetItemExtendedTooltip(newItem) )
        endif
        if SubString(BlzGetItemExtendedTooltip(oldItem), 0, 15) == "|cFFB20080Ditto" then
            call BlzSetItemExtendedTooltip(newItem, "|cFFB20080Ditto|r|n" + BlzGetItemExtendedTooltip(newItem)) // sadtwig
            //call BlzSetItemIconPath( newItem, "|cFFB20080Ditto|r|n" + BlzGetItemExtendedTooltip(newItem) )
        endif
        

        set owner=null
        set oldItem=null
        set newItem=null
    endfunction

    function Inventory_ReplaceItemByNew takes unit owner,item oldItem,integer newItem returns item

        call UnitRemoveItem(owner, oldItem)
        set bj_lastCreatedItem=CreateItem(newItem, GetUnitX(owner), GetUnitY(owner))
        call Inventory__SetModificators(owner , oldItem , bj_lastCreatedItem)
        call RemoveItem(oldItem)
        call UnitAddItem(owner, bj_lastCreatedItem)
        
        set owner=null
        set oldItem=null
        return bj_lastCreatedItem
    endfunction

    function Inventory_ReplaceItem takes unit owner,item oldItem,item newItem returns nothing
        
        call UnitRemoveItem(owner, oldItem)
        call Inventory__SetModificators(owner , oldItem , newItem)
        call RemoveItem(oldItem)
        if IsItemOwned(newItem) == false then
            call UnitAddItem(owner, newItem)
        endif
        
        set owner=null
        set oldItem=null
        set newItem=null
    endfunction


//library Inventory ends
//library IsSetItemLib:

    function IsSetItem takes integer it,integer settag returns boolean
        local integer cyclA= 1
        local integer cyclAEnd= udg_DB_SetItems_Num[settag]
        local boolean is= false
        
        loop
            exitwhen cyclA > cyclAEnd
            if it == s__DB_SetItems[(settag)*(100)+cyclA] then
                set is=true
                set cyclA=cyclAEnd
            endif
            set cyclA=cyclA + 1
        endloop
        
        return is
    endfunction

