function InitTrig_Mechs_for_dummies takes nothing returns nothing
    set gg_trg_Mechs_for_dummies=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_Mechs_for_dummies, EVENT_PLAYER_UNIT_SPELL_EFFECT)
