        call UnitApplyTimedLife(bj_lastCreatedUnit, 'BTLF', 10)
        call SetUnitState(bj_lastCreatedUnit, UNIT_STATE_LIFE, GetUnitState(boss, UNIT_STATE_LIFE))
    endif
    
    set boss=null
