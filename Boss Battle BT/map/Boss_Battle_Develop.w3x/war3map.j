        call s__HeroFramehandle_AddRoles(s__HeroFrame[(4)*(9)+2],ROLE_PHYSICAL_DAMAGE , ROLE_SUMMONER , 0 , 0)
        call s__HeroFramehandle_AddRoles(s__HeroFrame[(4)*(9)+3],ROLE_DEFEND , ROLE_MAGIC_DAMAGE , 0 , 0)
