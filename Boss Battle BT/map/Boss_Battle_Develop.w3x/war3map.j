    call TriggerRegisterAnyUnitEventBJ(gg_trg_RealBroQ, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_RealBroQ, Condition(function Trig_RealBroQ_Conditions))
