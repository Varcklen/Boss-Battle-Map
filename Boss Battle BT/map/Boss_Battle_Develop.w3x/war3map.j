        call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Undead\\AnimateDead\\AnimateDeadTarget.mdl", GetUnitX(bj_lastCreatedUnit), GetUnitY(bj_lastCreatedUnit)))
