        call SaveUnitHandle(udg_hash, id1, StringHash("bstt3u"), boss)
        call TimerStart(LoadTimerHandle(udg_hash, GetHandleId(dummy), StringHash("bstt3d")), bosscast(1), false, function Sheep3Repeat)
